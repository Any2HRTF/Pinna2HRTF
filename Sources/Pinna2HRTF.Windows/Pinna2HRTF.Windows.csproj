<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Pinna2HRTF.Windows</AssemblyName>
    <RootNamespace>Pinna2HRTF.Windows</RootNamespace>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0b</InformationalVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\app_icon.ico" />
    <None Include="..\..\ProjectSettingHelp.json" Link="ProjectSettingHelp.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
