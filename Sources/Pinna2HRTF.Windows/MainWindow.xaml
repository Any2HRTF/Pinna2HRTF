<Window x:Class="Pinna2HRTF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinna2HRTF" Icon="Resources/app_icon.ico" Width="1280" Height="820" MinWidth="900" MinHeight="680"
        Background="#f3f6f5" Loaded="WindowLoaded" Closing="WindowClosing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ProjectsColumn" Width="280" MinWidth="26" MaxWidth="360"/>
      <ColumnDefinition Width="*" MinWidth="300"/>
      <ColumnDefinition Width="370" MinWidth="310" MaxWidth="460"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#ffffff" BorderBrush="#d9dee8" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="ProjectsHeaderGrid" Grid.Row="0" Margin="10,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ProjectsTitle" Text="Projects" FontSize="18" Foreground="#7b8490" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="NewProjectButton" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Width="34" Margin="0" ToolTip="New project" Click="CreateProjectClicked"/>
            <Button x:Name="ImportProjectButton" Content="&#xE896;" FontFamily="Segoe MDL2 Assets" Width="34" ToolTip="Import project" Click="ImportProjectClicked" Margin="6,0,0,0"/>
            <Button x:Name="DuplicateProjectButton" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Width="34" ToolTip="Duplicate selected project" Click="DuplicateProjectClicked" Margin="6,0,0,0"/>
            <Button x:Name="DeleteProjectButton" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="34" ToolTip="Delete selected project" Click="RemoveProjectClicked" Margin="6,0,0,0"/>
            <Expander x:Name="ProjectsToggle" Width="26" Height="26" Margin="6,0,0,0" ExpandDirection="Right" IsExpanded="True" Expanded="ProjectsExpanded" Collapsed="ProjectsCollapsed" ToolTip="Collapse projects"/>
          </StackPanel>
        </Grid>
        <ListBox x:Name="ProjectList" Grid.Row="1" Margin="10,8,10,10" BorderThickness="0" SelectionChanged="ProjectSelectionChanged">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding StatusText}" Foreground="#7b8490" FontSize="11" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="5"/>
      <RowDefinition Height="170"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Margin="14" Background="#ffffff" BorderBrush="#d9dee8" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="14,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Artifact Viewer" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="SelectedArtifactText" Text="Select an artifact" Foreground="#69717d" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ComboBox x:Name="ArtifactPicker" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="ArtifactSelectionChanged" DisplayMemberPath="Title"/>
          </Grid>
          <Border x:Name="MeshViewerBackground" Grid.Row="1" Background="#edf3f2" BorderBrush="#dbe5e3" BorderThickness="0,1,0,0">
            <Grid>
              <Viewport3D x:Name="MeshViewport" ClipToBounds="True"
                          MouseLeftButtonDown="MeshViewportMouseLeftButtonDown"
                          MouseLeftButtonUp="MeshViewportMouseLeftButtonUp"
                          MouseMove="MeshViewportMouseMove"
                          MouseWheel="MeshViewportMouseWheel"
                          MouseLeave="MeshViewportMouseLeave">
                <Viewport3D.Camera>
                  <PerspectiveCamera x:Name="MeshCamera" Position="0,-280,120" LookDirection="0,280,-120" UpDirection="0,0,1" FieldOfView="38"/>
                </Viewport3D.Camera>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <DirectionalLight Color="#ffffff" Direction="-1,2,-3"/>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <DirectionalLight Color="#d9e7ff" Direction="1,-2,-1"/>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <DirectionalLight Color="#ffe9d2" Direction="0,1,2"/>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <AmbientLight Color="#a8a8a8"/>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
              </Viewport3D>
              <Border x:Name="MeshControlsHint" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                      Padding="8,5" Background="#ccffffff" CornerRadius="4" Visibility="Collapsed">
                <TextBlock x:Name="MeshControlsHintText" Text="Drag to rotate  |  Mouse wheel to zoom" Foreground="#69717d" FontSize="12"/>
              </Border>
              <Image x:Name="ImagePreview" Stretch="Uniform" Margin="18" Visibility="Collapsed"/>
              <TextBlock x:Name="ViewerPlaceholder" Text="No artifact selected" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#69717d" FontSize="18"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
      <Grid x:Name="LiveLogPanel" Grid.Row="2" Margin="14,0,14,14">
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#d9dee8" BorderThickness="1,1,1,0">
          <Grid>
            <Expander x:Name="LiveLogToggle" Width="26" Height="26" Margin="2,2,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" ExpandDirection="Up" IsExpanded="True" Expanded="LiveLogExpanded" Collapsed="LiveLogCollapsed" ToolTip="Collapse live log"/>
            <TextBlock Text="Live Log" FontWeight="SemiBold" VerticalAlignment="Center" Margin="34,0,0,0"/>
            <Button x:Name="ClearLogButton" Content="Clear" Click="ClearLogClicked" HorizontalAlignment="Right" VerticalAlignment="Center" Height="24" Padding="10,1" FontSize="11" Margin="0,0,6,0" Foreground="#69717d" Background="#f3f6f5" BorderBrush="#d9dee8"/>
          </Grid>
        </Border>
        <Border x:Name="LiveLogContent" Grid.Row="1" Background="#ffffff" BorderBrush="#d9dee8" BorderThickness="1,0,1,1">
          <TextBox x:Name="LogText" Margin="10" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Column="2" Background="#fbfbfc" BorderBrush="#d9dee8" BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <TextBlock Text="Project" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Label Content="Project name"/>
          <TextBox x:Name="ProjectNameBox" TextChanged="ProjectEdited"/>
          <Label Content="Left ear (optional)"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseLeftEarClicked"/>
            <TextBox x:Name="LeftEarBox" TextChanged="ProjectEdited"/>
          </DockPanel>
          <Label Content="Right ear (optional)"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseRightEarClicked"/>
            <TextBox x:Name="RightEarBox" TextChanged="ProjectEdited"/>
          </DockPanel>
          <Label Content="Save location"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseSaveLocationClicked"/>
            <TextBox x:Name="SaveLocationBox" TextChanged="ProjectEdited"/>
          </DockPanel>
          <TextBlock Text="Choose at least one ear mesh." Margin="0,4,0,0" Foreground="#69717d"/>
          <CheckBox x:Name="UsePredictionsBox" Content="Use BezierPPM" Margin="0,2,0,8" Checked="ProjectEdited" Unchecked="ProjectEdited"/>
          <Expander Header="BezierPPM Inference" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <Label Content="Model"/>
              <ComboBox x:Name="ModelPicker" SelectionChanged="ModelSelectionChanged"/>
            </StackPanel>
          </Expander>
          <Expander Header="Mesh2HRTF" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <Label Content="Evaluation grid"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseEvaluationGridClicked"/>
                <TextBox x:Name="EvaluationGridBox" TextChanged="ProjectEdited"/>
              </DockPanel>
              <CheckBox x:Name="UseHeadRadiusBox" Content="Use custom head radius" Margin="0,8,0,0" Checked="ProjectEdited" Unchecked="ProjectEdited"/>
              <Label Content="Head radius"/>
              <TextBox x:Name="HeadRadiusBox" TextChanged="ProjectEdited"/>
              <Label Content="Min frequency"/>
              <TextBox x:Name="MinFrequencyBox" TextChanged="ProjectEdited"/>
              <Label Content="Max frequency"/>
              <TextBox x:Name="MaxFrequencyBox" TextChanged="ProjectEdited"/>
              <Label Content="Frequency steps (minimum 2)"/>
              <TextBox x:Name="FrequencyStepsBox" TextChanged="ProjectEdited"/>
              <Label Content="Microphone faces"/>
              <TextBox x:Name="SourceAssignmentFaceCountBox" TextChanged="ProjectEdited"/>
            </StackPanel>
          </Expander>
          <Expander Header="Mesh Grading" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="Required safety step" Foreground="#69717d" Margin="0,0,0,8"/>
              <Label Content="Min edge length"/>
              <TextBox x:Name="MeshMinEdgeBox" TextChanged="ProjectEdited"/>
              <Label Content="Max edge length"/>
              <TextBox x:Name="MeshMaxEdgeBox" TextChanged="ProjectEdited"/>
              <Label Content="Max error"/>
              <TextBox x:Name="MeshMaxErrorBox" TextChanged="ProjectEdited"/>
              <Label Content="Gamma"/>
              <TextBox x:Name="MeshGammaBox" TextChanged="ProjectEdited"/>
              <Label Content="Gamma opposite"/>
              <TextBox x:Name="MeshGammaOppositeBox" TextChanged="ProjectEdited"/>
            </StackPanel>
          </Expander>
          <Expander Header="NumCalc" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <Label Content="Parallel instances"/>
              <TextBox x:Name="MaxInstancesBox" TextChanged="ProjectEdited"/>
              <Label Content="CPU limit (%)"/>
              <TextBox x:Name="MaxCpuLoadBox" TextChanged="ProjectEdited"/>
              <CheckBox x:Name="AdaptiveFmmLengthBox" Content="Adaptive FMM expansion length" IsChecked="True" Checked="ProjectEdited" Unchecked="ProjectEdited"/>
            </StackPanel>
          </Expander>
          <Expander Header="Postprocessing" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <CheckBox x:Name="NormalizeHrtfsBox" Content="Normalize HRTFs" Checked="ProjectEdited" Unchecked="ProjectEdited"/>
              <Label Content="Level offset (dB)"/>
              <TextBox x:Name="LevelOffsetBox" TextChanged="ProjectEdited"/>
            </StackPanel>
          </Expander>
        </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#d9dee8" BorderThickness="0,1,0,0">
        <StackPanel Margin="14,8,14,14">
          <StackPanel Margin="0,0,0,4">
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="BezierPPM Inference" VerticalAlignment="Center"/>
              <TextBlock x:Name="InferenceStatusText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Foreground="#69717d"/>
              <Button x:Name="RunInferenceButton" Grid.Column="2" Content="Run" Click="RunInferenceClicked" Padding="12,3"/>
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Preprocessing" VerticalAlignment="Center"/>
              <TextBlock x:Name="PreprocessingStatusText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Foreground="#69717d"/>
              <Button x:Name="RunPreprocessingButton" Grid.Column="2" Content="Run" Click="RunPreprocessingClicked" Padding="12,3"/>
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="NumCalc" VerticalAlignment="Center"/>
              <TextBlock x:Name="NumCalcStageStatusText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Foreground="#69717d"/>
              <Button x:Name="RunNumCalcButton" Grid.Column="2" Content="Run" Click="RunNumCalcClicked" Padding="12,3"/>
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Postprocess" VerticalAlignment="Center"/>
              <TextBlock x:Name="PostprocessingStatusText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Foreground="#69717d"/>
              <Button x:Name="RunPostprocessingButton" Grid.Column="2" Content="Run" Click="RunPostprocessingClicked" Padding="12,3"/>
            </Grid>
          </StackPanel>
          <Button Content="Run All" Click="RunAllClicked" Height="34" Margin="0,8,0,0" Background="#6f9f9c" Foreground="White" FontWeight="SemiBold"/>
          <Grid Margin="0,6,0,0">
            <TextBlock x:Name="NumCalcStatusText" Foreground="#69717d" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,110,0"/>
            <Button HorizontalAlignment="Right" Content="Reset Outputs" Click="ResetOutputsClicked" Padding="10,3" FontSize="11"/>
          </Grid>
        </StackPanel>
        </Border>
      </Grid>
    </Border>
    <GridSplitter Grid.Row="0" Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"/>
    <GridSplitter Grid.Row="0" Grid.Column="2" Width="5" HorizontalAlignment="Left" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"/>
    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#eef1f5" BorderBrush="#d9dee8" BorderThickness="0,1,0,0" Padding="12,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <ProgressBar x:Name="BusyProgress" Width="72" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,8,0"/>
          <TextBlock x:Name="BusyStatusText" Text="Ready" FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock x:Name="PipelineStatusText" Grid.Column="1" Foreground="#4f5967" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
