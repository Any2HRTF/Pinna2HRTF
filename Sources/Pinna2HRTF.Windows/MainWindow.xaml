<Window x:Class="Pinna2HRTF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinna2HRTF" Icon="Resources/app_icon.ico" Width="1280" Height="820" MinWidth="900" MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}" Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowPreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#f3f6f5"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#fbfbfc"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1a1a1a"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#69717d"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#d9dee8"/>
    <SolidColorBrush x:Key="ComboSelectedBrush" Color="#d9eaf0"/>
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#edf3f5"/>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/><Setter Property="Foreground" Value="#1a1a1a"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Padding" Value="6,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Content" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboSelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    <Style x:Key="SettingInfoButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="5,0,0,0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Opacity" Value="0.72"/>
      <Setter Property="ToolTip" Value="Show information"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ProjectsColumn" Width="280" MinWidth="26" MaxWidth="360"/>
      <ColumnDefinition Width="*" MinWidth="300"/>
      <ColumnDefinition Width="370" MinWidth="310" MaxWidth="460"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="ProjectsPane" Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="ProjectsHeaderGrid" Grid.Row="0" Margin="10,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ProjectsTitle" Text="Projects" FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="NewProjectButton" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Width="34" Margin="0" ToolTip="New project" Click="CreateProjectClicked"/>
            <Button x:Name="ImportProjectButton" Content="&#xE896;" FontFamily="Segoe MDL2 Assets" Width="34" ToolTip="Import project" Click="ImportProjectClicked" Margin="6,0,0,0"/>
            <Button x:Name="DuplicateProjectButton" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Width="34" ToolTip="Duplicate selected project" Click="DuplicateProjectClicked" Margin="6,0,0,0"/>
            <Button x:Name="DeleteProjectButton" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="34" ToolTip="Delete selected project" Click="RemoveProjectClicked" Margin="6,0,0,0"/>
            <Expander x:Name="ProjectsToggle" Width="26" Height="26" Margin="6,0,0,0" ExpandDirection="Right" IsExpanded="True" Expanded="ProjectsExpanded" Collapsed="ProjectsCollapsed" ToolTip="Collapse projects"/>
          </StackPanel>
        </Grid>
        <ListBox x:Name="ProjectList" Grid.Row="1" Margin="10,8,10,10" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="ProjectSelectionChanged">
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="2,5"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><Ellipse Width="15" Height="15" Margin="8,0,0,0" HorizontalAlignment="Right" Stroke="#6f9f9c" StrokeThickness="2" StrokeDashArray="2 3" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"><Ellipse.RenderTransform><RotateTransform CenterX="7.5" CenterY="7.5"/></Ellipse.RenderTransform><Ellipse.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers></Ellipse></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="5"/>
      <RowDefinition Height="170"/>
      </Grid.RowDefinitions>
      <Border x:Name="ArtifactCard" Grid.Row="0" Margin="14" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="14,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Preview" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="SelectedArtifactText" Text="Select a file to preview" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ComboBox x:Name="ArtifactPicker" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="ArtifactSelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          </Grid>
          <Border x:Name="MeshViewerBackground" Grid.Row="1" Background="#edf3f2" BorderBrush="#dbe5e3" BorderThickness="0,1,0,0">
            <Grid>
              <Viewport3D x:Name="MeshViewport" ClipToBounds="True"
                          MouseLeftButtonDown="MeshViewportMouseLeftButtonDown"
                          MouseLeftButtonUp="MeshViewportMouseLeftButtonUp"
                          MouseMove="MeshViewportMouseMove"
                          MouseWheel="MeshViewportMouseWheel"
                          MouseLeave="MeshViewportMouseLeave">
                <Viewport3D.Camera>
                  <PerspectiveCamera x:Name="MeshCamera" Position="0,-280,120" LookDirection="0,280,-120" UpDirection="0,0,1" FieldOfView="38"/>
                </Viewport3D.Camera>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <DirectionalLight Color="#ffffff" Direction="-1,2,-3"/>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <DirectionalLight Color="#d9e7ff" Direction="1,-2,-1"/>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <DirectionalLight Color="#ffe9d2" Direction="0,1,2"/>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <AmbientLight Color="#a8a8a8"/>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
              </Viewport3D>
              <Border x:Name="MeshControlsHint" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                      Padding="8,5" Background="#ccffffff" CornerRadius="4" Visibility="Collapsed">
                <TextBlock x:Name="MeshControlsHintText" Text="Drag to rotate  |  Mouse wheel to zoom" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
              </Border>
              <Image x:Name="ImagePreview" Stretch="Uniform" Margin="18" Visibility="Collapsed"/>
              <TextBlock x:Name="ViewerPlaceholder" Text="No preview selected" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="18"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
      <Grid x:Name="LiveLogPanel" Grid.Row="2" Margin="14,0,14,14">
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="LiveLogHeader" Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0">
          <Grid>
            <Expander x:Name="LiveLogToggle" Width="26" Height="26" Margin="2,2,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" ExpandDirection="Up" IsExpanded="True" Expanded="LiveLogExpanded" Collapsed="LiveLogCollapsed" ToolTip="Collapse live log"/>
            <TextBlock Text="Live Log" FontWeight="SemiBold" VerticalAlignment="Center" Margin="34,0,0,0"/>
            <Button x:Name="ClearLogButton" Content="Clear" Click="ClearLogClicked" HorizontalAlignment="Right" VerticalAlignment="Center" Height="24" Padding="10,1" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource SecondaryTextBrush}" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
          </Grid>
        </Border>
        <Border x:Name="LiveLogContent" Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1">
          <TextBox x:Name="LogText" Margin="10" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
        </Border>
      </Grid>
    </Grid>
    <Border x:Name="SettingsPane" Grid.Column="2" Background="{DynamicResource SettingsBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <TextBlock Text="Project" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="project.name" Click="SettingInfoClicked"/>
            <Label Content="Project name"/>
          </DockPanel>
          <TextBox x:Name="ProjectNameBox" TextChanged="ProjectEdited"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="project.left_ear" Click="SettingInfoClicked"/>
            <Label Content="Left ear (optional)"/>
          </DockPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseLeftEarClicked"/>
            <TextBox x:Name="LeftEarBox" TextChanged="ProjectEdited"/>
          </DockPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="project.right_ear" Click="SettingInfoClicked"/>
            <Label Content="Right ear (optional)"/>
          </DockPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseRightEarClicked"/>
            <TextBox x:Name="RightEarBox" TextChanged="ProjectEdited"/>
          </DockPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="project.save_location" Click="SettingInfoClicked"/>
            <Label Content="Save location"/>
          </DockPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseSaveLocationClicked"/>
            <TextBox x:Name="SaveLocationBox" TextChanged="ProjectEdited"/>
          </DockPanel>
          <TextBlock Text="Choose at least one ear mesh." Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
          <DockPanel Margin="0,2,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="project.use_bezierppm" Click="SettingInfoClicked"/>
            <CheckBox x:Name="UsePredictionsBox" Content="Use BezierPPM" Checked="ProjectEdited" Unchecked="ProjectEdited"/>
          </DockPanel>
          <Expander Header="BezierPPM Inference" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="inference.model" Click="SettingInfoClicked"/>
                <Label Content="Model"/>
              </DockPanel>
              <ComboBox x:Name="ModelPicker" SelectionChanged="ModelSelectionChanged"/>
            </StackPanel>
          </Expander>
          <Expander Header="Mesh2HRTF" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh2hrtf.evaluation_grid" Click="SettingInfoClicked"/>
                <Label Content="Evaluation grid"/>
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseEvaluationGridClicked"/>
                <TextBox x:Name="EvaluationGridBox" TextChanged="ProjectEdited"/>
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh2hrtf.use_head_radius" Click="SettingInfoClicked"/>
                <CheckBox x:Name="UseHeadRadiusBox" Content="Use custom head radius" Checked="ProjectEdited" Unchecked="ProjectEdited"/>
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh2hrtf.head_radius" Click="SettingInfoClicked"/>
                <Label Content="Head radius"/>
              </DockPanel>
              <TextBox x:Name="HeadRadiusBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh2hrtf.min_frequency" Click="SettingInfoClicked"/>
                <Label Content="Min frequency"/>
              </DockPanel>
              <TextBox x:Name="MinFrequencyBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh2hrtf.max_frequency" Click="SettingInfoClicked"/>
                <Label Content="Max frequency"/>
              </DockPanel>
              <TextBox x:Name="MaxFrequencyBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh2hrtf.frequency_steps" Click="SettingInfoClicked"/>
                <Label Content="Frequency steps (minimum 2)"/>
              </DockPanel>
              <TextBox x:Name="FrequencyStepsBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh2hrtf.microphone_faces" Click="SettingInfoClicked"/>
                <Label Content="Microphone faces"/>
              </DockPanel>
              <TextBox x:Name="SourceAssignmentFaceCountBox" TextChanged="ProjectEdited"/>
            </StackPanel>
          </Expander>
          <Expander Header="Mesh Grading" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="Required safety step" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh_grading.min_edge_length" Click="SettingInfoClicked"/>
                <Label Content="Min edge length"/>
              </DockPanel>
              <TextBox x:Name="MeshMinEdgeBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh_grading.max_edge_length" Click="SettingInfoClicked"/>
                <Label Content="Max edge length"/>
              </DockPanel>
              <TextBox x:Name="MeshMaxEdgeBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh_grading.max_error" Click="SettingInfoClicked"/>
                <Label Content="Max error"/>
              </DockPanel>
              <TextBox x:Name="MeshMaxErrorBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh_grading.gamma" Click="SettingInfoClicked"/>
                <Label Content="Gamma"/>
              </DockPanel>
              <TextBox x:Name="MeshGammaBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="mesh_grading.gamma_opposite" Click="SettingInfoClicked"/>
                <Label Content="Gamma opposite"/>
              </DockPanel>
              <TextBox x:Name="MeshGammaOppositeBox" TextChanged="ProjectEdited"/>
            </StackPanel>
          </Expander>
          <Expander Header="NumCalc" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="numcalc.parallel_instances" Click="SettingInfoClicked"/>
                <Label Content="Parallel instances"/>
              </DockPanel>
              <TextBox x:Name="MaxInstancesBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="numcalc.cpu_limit" Click="SettingInfoClicked"/>
                <Label Content="CPU limit (%)"/>
              </DockPanel>
              <TextBox x:Name="MaxCpuLoadBox" TextChanged="ProjectEdited"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="numcalc.adaptive_fmm" Click="SettingInfoClicked"/>
                <CheckBox x:Name="AdaptiveFmmLengthBox" Content="Adaptive FMM expansion length" IsChecked="True" Checked="ProjectEdited" Unchecked="ProjectEdited"/>
              </DockPanel>
            </StackPanel>
          </Expander>
          <Expander Header="Postprocessing" IsExpanded="False" Margin="0,8,0,0">
            <StackPanel Margin="0,8,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="postprocessing.normalize" Click="SettingInfoClicked"/>
                <CheckBox x:Name="NormalizeHrtfsBox" Content="Normalize HRTFs" Checked="ProjectEdited" Unchecked="ProjectEdited"/>
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingInfoButtonStyle}" Content="&#xE946;" Tag="postprocessing.level_offset" Click="SettingInfoClicked"/>
                <Label Content="Level offset (dB)"/>
              </DockPanel>
              <TextBox x:Name="LevelOffsetBox" TextChanged="ProjectEdited"/>
            </StackPanel>
          </Expander>
        </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel Margin="14,8,14,14">
          <StackPanel Margin="0,0,0,4">
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="BezierPPM Inference" VerticalAlignment="Center"/>
              <TextBlock x:Name="InferenceStatusText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <Button x:Name="RunInferenceButton" Grid.Column="2" Content="Run" Click="RunInferenceClicked" Padding="12,3"/>
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Preprocessing" VerticalAlignment="Center"/>
              <TextBlock x:Name="PreprocessingStatusText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <Button x:Name="RunPreprocessingButton" Grid.Column="2" Content="Run" Click="RunPreprocessingClicked" Padding="12,3"/>
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="NumCalc" VerticalAlignment="Center"/>
              <TextBlock x:Name="NumCalcStageStatusText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <Button x:Name="RunNumCalcButton" Grid.Column="2" Content="Run" Click="RunNumCalcClicked" Padding="12,3"/>
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Postprocess" VerticalAlignment="Center"/>
              <TextBlock x:Name="PostprocessingStatusText" Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <Button x:Name="RunPostprocessingButton" Grid.Column="2" Content="Run" Click="RunPostprocessingClicked" Padding="12,3"/>
            </Grid>
          </StackPanel>
          <Button x:Name="RunAllButton" Content="Run All" Click="RunAllClicked" Height="34" Margin="0,8,0,0" Background="#6f9f9c" Foreground="White" FontWeight="SemiBold"/>
          <Grid Margin="0,6,0,0">
            <TextBlock x:Name="NumCalcStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,110,0"/>
            <Button HorizontalAlignment="Right" Content="Reset Outputs" Click="ResetOutputsClicked" Padding="10,3" FontSize="11"/>
          </Grid>
        </StackPanel>
        </Border>
      </Grid>
    </Border>
    <GridSplitter Grid.Row="0" Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"/>
    <GridSplitter Grid.Row="0" Grid.Column="2" Width="5" HorizontalAlignment="Left" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"/>
    <Popup x:Name="SettingHelpPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border x:Name="SettingHelpCard" Width="360" Padding="14" Background="#ffffff" BorderBrush="#cfd6df" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock x:Name="SettingHelpTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="SettingHelpDescription" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#3f4854"/>
          <TextBlock x:Name="SettingHelpPublicationsLabel" Text="Publications" Margin="0,12,0,4" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
          <ItemsControl x:Name="SettingHelpPublications">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Title}" Tag="{Binding Url}" Click="PublicationClicked" HorizontalAlignment="Left" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#1769aa"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
